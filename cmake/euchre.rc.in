// Windows resources: the icon and version information
#include <windows.h>

IDI_ICON1 ICON "@EUCHRE_ICO@"

1 VERSIONINFO
 FILEVERSION @EUCHRE_VERSION_RC@
 PRODUCTVERSION @EUCHRE_VERSION_RC@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Euchre"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "euchre"
            VALUE "OriginalFilename", "euchre.exe"
            VALUE "ProductName", "Euchre"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
            VALUE "LegalCopyright", "Released into the public domain (UNLICENSE)"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
